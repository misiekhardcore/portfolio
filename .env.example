# PostgreSQL — must match docker-compose.yml
DATABASE_URL=postgres://portfolio:portfolio_pwd@127.0.0.1:5433/portfolio
# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=change-me
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Nextcloud (image storage)
NEXTCLOUD_BASE=https://your-nextcloud.example.com
NEXTCLOUD_USER=your-username
NEXTCLOUD_PASS=your-app-password
NEXTCLOUD_MEDIA_ROOT=Portfolio

POSTGRES_PASSWORD=portfolio_pwd